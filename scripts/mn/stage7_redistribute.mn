sh pkill -f "[a]pp.task_manager"
sh pkill -f "[a]pp.worker"
sh sleep 2
h1 python3 -u -m app.task_manager > results/s7a_manager.log 2>&1 &
w1 python3 -u -m app.worker --id w1 --manager 10.0.0.1 > results/s7a_w1.log 2>&1 &
w2 python3 -u -m app.worker --id w2 --manager 10.0.0.1 > results/s7a_w2.log 2>&1 &
w3 python3 -u -m app.worker --id w3 --manager 10.0.0.1 > results/s7a_w3.log 2>&1 &
w4 python3 -u -m app.worker --id w4 --manager 10.0.0.1 > results/s7a_w4.log 2>&1 &
sh sleep 2
h2 python3 -u -m app.client --manager 10.0.0.1 --tasks 40 --work-ms 500 --wait-workers 4 --out results/s7a_client.json > results/s7a_client.log 2>&1 &
sh sleep 1
sh pkill -f "[a]pp.worker --id 10.0.0.12"
sh sleep 12
sh echo "=== client summary"
sh cat results/s7a_client.log
sh echo "=== manager events"
sh grep -E "FAILED|requeued" results/s7a_manager.log
sh echo "=== app flows still installed for w2 (expect 0)"
sh ovs-ofctl -O OpenFlow13 dump-flows s1 | grep priority=20 | grep -c 10.0.0.12
