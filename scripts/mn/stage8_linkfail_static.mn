sh python3 scripts/ctl.py mode static
link s1 s2 up
sh pkill -f "[a]pp.task_manager"
sh pkill -f "[a]pp.worker"
sh pkill -f "[p]ing -D"
sh sleep 2
h1 python3 -u -m app.task_manager > results/s8lf_static_manager.log 2>&1 &
w1 python3 -u -m app.worker --id w1 --manager 10.0.0.1 > results/s8lf_static_w1.log 2>&1 &
w2 python3 -u -m app.worker --id w2 --manager 10.0.0.1 > results/s8lf_static_w2.log 2>&1 &
w3 python3 -u -m app.worker --id w3 --manager 10.0.0.1 > results/s8lf_static_w3.log 2>&1 &
w4 python3 -u -m app.worker --id w4 --manager 10.0.0.1 > results/s8lf_static_w4.log 2>&1 &
sh sleep 3
h1 ping -D -i 0.05 -w 22 10.0.0.11 > results/s8lf_static_ping.log 2>&1 &
h2 python3 -u -m app.client --manager 10.0.0.1 --tasks 100 --work-ms 300 --wait-workers 4 --out results/s8lf_static_client.json > results/s8lf_static_client.log 2>&1 &
sh sleep 4
sh date +%s.%N > results/s8lf_static_times.txt
link s1 s2 down
sh sleep 8
sh date +%s.%N >> results/s8lf_static_times.txt
link s1 s2 up
sh sleep 13
sh python3 scripts/ctl.py state-json > results/s8lf_static_state.json
sh echo "=== client summary"
sh cat results/s8lf_static_client.log
sh python3 scripts/check_s8.py linkfail static
