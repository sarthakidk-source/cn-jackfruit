sh mkdir -p results/exp
sh echo "[congestion static run 1]"
link s1 s2 up
sh pkill -f "[a]pp.task_manager"
sh pkill -f "[a]pp.worker"
sh pkill -f "[i]perf"
sh pkill -f "[p]ing -D"
sh sleep 2
sh python3 scripts/ctl.py mode static
sh date +%s.%N > results/exp/congestion_static_r1_times.txt
h1 python3 -u -m app.task_manager > results/exp/congestion_static_r1_manager.log 2>&1 &
w1 python3 -u -m app.worker --id w1 --manager 10.0.0.1 > results/exp/congestion_static_r1_w1.log 2>&1 &
w2 python3 -u -m app.worker --id w2 --manager 10.0.0.1 > results/exp/congestion_static_r1_w2.log 2>&1 &
w3 python3 -u -m app.worker --id w3 --manager 10.0.0.1 > results/exp/congestion_static_r1_w3.log 2>&1 &
w4 python3 -u -m app.worker --id w4 --manager 10.0.0.1 > results/exp/congestion_static_r1_w4.log 2>&1 &
sh sleep 3
w2 iperf -u -s > results/exp/congestion_static_r1_iperf_server.log 2>&1 &
sh sleep 1
h2 iperf -u -c 10.0.0.12 -b 9M -t 120 -i 1 > results/exp/congestion_static_r1_iperf_client.log 2>&1 &
sh sleep 9
h2 python3 -u -m app.client --manager 10.0.0.1 --tasks 40 --work-ms 50 --payload-kb 100 --wait-workers 4 --timeout 90 --out results/exp/congestion_static_r1_client.json > results/exp/congestion_static_r1_client.log 2>&1
sh python3 scripts/ctl.py state-json > results/exp/congestion_static_r1_state.json
sh pkill -f "[i]perf"
